{
  "name": "omp-openhop",
  "version": "1.3.0",
  "description": "OMP plugin: status, hop and doctor for a local openhop install, with automatic WARP /64 rotation on OpenCode free-tier limits",
  "type": "module",
  "main": "src/index.ts",
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "selfcheck": "bun selfcheck.ts"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "keywords": [
    "omp",
    "pi-package",
    "pi-extension",
    "openhop",
    "opencode",
    "warp",
    "cloudflare",
    "coding-agent"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@oh-my-pi/pi-coding-agent": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yayayapluto/OMP-openhop.git"
  },
  "homepage": "https://github.com/yayayapluto/OMP-openhop#readme",
  "bugs": {
    "url": "https://github.com/yayayapluto/OMP-openhop/issues"
  },
  "license": "MIT"
}
